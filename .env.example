# F-1 Job Hunter — Email Credentials
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it's already in .gitignore

# Your Gmail address (the account you'll send FROM)
SENDER_EMAIL=

# Gmail App Password (NOT your regular Gmail password)
# How to get one: Google Account → Security → 2-Step Verification → App Passwords
# Name it "F1 Job Hunter" and paste the 16-character code below
GMAIL_APP_PASSWORD=
